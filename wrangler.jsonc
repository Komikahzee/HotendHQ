{
  // Hotend HQ — Cloudflare Workers config.
  // Build: wrangler runs `node build/build.mjs` itself (the "build" field below), which writes ./dist,
  // before every deploy or preview upload, so it works even when the dashboard's build command is empty.
  // Deploy command: npx wrangler deploy
  "name": "hotendhq",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-18",
  "build": { "command": "node build/build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // the worker only wakes up for the old article URLs, to 301 them
    "run_worker_first": ["/article", "/article.html"]
  }
}
